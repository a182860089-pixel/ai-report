# Copy to .env and fill in. Never commit .env.

DEBUG=true
REPOSITORY=memory
JWT_SECRET=please-change-me-to-a-32-byte-secret!!
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now-12
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# Postgres mode (docker compose, port 5432):
# REPOSITORY=postgres
# DATABASE_URL=postgresql+asyncpg://ai_report_app:ai_report_app@127.0.0.1:5432/ai_report
# ALEMBIC_DATABASE_URL=postgresql+psycopg://ai_report_migrator:ai_report_migrator@127.0.0.1:5432/ai_report

# Postgres mode (no Docker: scripts/pg_local.py, port 55432).
# Use 127.0.0.1, never localhost (Windows may resolve localhost to ::1).
# REPOSITORY=postgres
# DATABASE_URL=postgresql+asyncpg://ai_report_app:ai_report_app@127.0.0.1:55432/ai_report
# ALEMBIC_DATABASE_URL=postgresql+psycopg://ai_report_migrator:ai_report_migrator@127.0.0.1:55432/ai_report

# RS256 alternative (mutually exclusive with JWT_SECRET):
# JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem

# In-process scheduler. Real RSS fetch requires REPOSITORY=postgres.
# Times are Asia/Shanghai. Auto-cluster writes draft stories for today.
PIPELINE_SCHEDULER_ENABLED=false
PIPELINE_SCHEDULE=06:30,12:30,18:30
PIPELINE_AUTO_CLUSTER=true

