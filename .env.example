# FastAPI origin used by Next server components and /api/v1 rewrites.
# Canonical local port is 8000. This checkout currently serves Postgres FastAPI on 8001
# because 8000 is occupied; .env.local points at 8001.
API_BASE=http://127.0.0.1:8000

# Optional. If set, the browser calls this origin directly (needs CORS).
# Leave unset to use same-origin /api/v1 via the rewrite above.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
