:80 {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	handle /api/v1* {
		reverse_proxy api:8000
	}

	handle /healthz {
		reverse_proxy api:8000
	}

	handle /readyz {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
